[Unit]
Description=RoboCup screen remote to car decision centre
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cooper
Group=cooper
SupplementaryGroups=dialout
WorkingDirectory=@PROJECT_ROOT@
ExecStart=/usr/bin/python3 -B -u -m components.competition_remote --station-config /etc/robocup-ground-station/station.json --remote-config /etc/robocup-ground-station/competition_remote.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
